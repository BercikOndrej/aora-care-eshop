# Copy this file to .env and fill in real production values.
# ASP.NET Core maps __ to : so ConnectionStrings__Default overrides ConnectionStrings:Default.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aoracare
POSTGRES_USER=aoracare
POSTGRES_PASSWORD=change_me_in_production

ConnectionStrings__Default=Host=${POSTGRES_HOST};Port=${POSTGRES_PORT};Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}

Jwt__SecretKey=change_to_a_random_32_char_secret_here!!
Jwt__Issuer=aora-care
Jwt__Audience=aora-care
